# Copiar a .env y llenar con los valores reales del proyecto de Supabase de
# sistema-control-jornada (mismo proyecto, este repo es un cliente más de esa base).

# URL del proyecto Supabase (Settings > API).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Secreto JWT del proyecto (Settings > API > JWT Settings) -- se usa para AUTOFIRMAR el token
# con claim role=terminal_checador (ver app/jwt_terminal.py). Nunca es la anon key ni una
# service_role key en este uso.
SUPABASE_JWT_SECRET=

# TEMPORAL, sólo para app/routers/personas.py (refresco de persona_cache) mientras no existe un
# mecanismo de lectura más angosto -- ver README "Qué falta para la Raspberry Pi". Es la
# service_role key real del proyecto: tratarla con el mismo cuidado que en sistema-control-jornada
# (nunca en el repo, nunca en logs).
SUPABASE_SERVICE_ROLE_KEY=

# Identificador de este aparato (terminal_id en tiempo.marca, <=32 caracteres). Un UUID o un
# nombre corto estable por dispositivo.
DISPOSITIVO_ID=checador-pruebas-01

# Ruta del archivo SQLite local. Relativa a donde se levanta uvicorn si no es absoluta.
DB_PATH=checador.db
